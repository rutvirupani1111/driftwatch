{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rutvirupani1111.github.io/driftwatch/driftwatch.schema.json",
  "title": "Driftwatch configuration",
  "description": "Which public JSON APIs Driftwatch should watch. Header values, URLs and bodies may reference ${SECRET_NAME} environment variables (GitHub Secrets).",
  "type": "object",
  "required": ["monitors"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "site": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string", "description": "Dashboard title." },
        "description": { "type": "string" },
        "url": { "type": "string", "format": "uri", "description": "Public URL of the dashboard (used in feeds and alerts). The SITE_URL env var overrides it." },
        "repo": { "type": "string", "pattern": "^[\\w.-]+/[\\w.-]+$", "description": "owner/repo on GitHub." }
      }
    },
    "schedule": { "type": "string", "description": "Cron expression of the monitor workflow (informational; keep it in sync with .github/workflows/monitor.yml).", "default": "17 */3 * * *" },
    "userAgent": { "type": "string", "description": "User-Agent sent with every request." },
    "timeoutMs": { "type": "integer", "minimum": 1000, "maximum": 60000, "default": 15000 },
    "concurrency": { "type": "integer", "minimum": 1, "maximum": 10, "default": 4 },
    "monitors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "category", "url", "docs"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$", "description": "Stable slug; used for file names, URLs and badges." },
          "name": { "type": "string" },
          "category": { "type": "string" },
          "url": { "type": "string", "description": "http(s) URL; may contain ${SECRET_NAME}." },
          "method": { "type": "string", "enum": ["GET", "POST", "PUT", "PATCH", "DELETE", "HEAD", "OPTIONS"], "default": "GET" },
          "headers": { "type": "object", "additionalProperties": { "type": "string" }, "description": "Extra headers. A header whose ${SECRET} is not set is skipped." },
          "body": { "description": "Request body. Objects are sent as JSON." },
          "docs": { "type": "string", "format": "uri" },
          "logo": { "type": "string", "description": "Image URL or a 1-3 character monogram." },
          "description": { "type": "string" },
          "ignore": { "type": "array", "items": { "type": "string", "pattern": "^\\$" }, "description": "JSONPath-lite paths to leave out of the contract, e.g. $.meta.debug or $.items[].tracking." },
          "timeoutMs": { "type": "integer", "minimum": 1000, "maximum": 60000 }
        }
      }
    }
  }
}
